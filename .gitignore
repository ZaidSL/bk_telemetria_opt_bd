# Archivos pesados de backups locales y previews
backup_storage/full_backups/*.dump
backup_storage/incremental_backups/*
!backup_storage/incremental_backups/.gitkeep
backup_storage/wal_archive/*
!backup_storage/wal_archive/.gitkeep
!backup_storage/full_backups/.gitkeep
presentacion/preview_*.pptx
presentacion/*_preview.pptx
presentacion/~$*.pptx

# Datos de contenedores y logs locales
*.log
.env
__pycache__/
*.pyc

# Agente IA — archivos de salida generados en cada ejecución
agente_ia/ultimo_contexto.json
agente_ia/reporte_ia.md

# IDEs y SO
.vscode/
.idea/
Thumbs.db
Desktop.ini
