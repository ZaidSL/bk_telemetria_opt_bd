# ═══════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO PARA EL AGENTE DE OPTIMIZACIÓN IA
#
# INSTRUCCIONES:
#   1. Copia este archivo como .env (sin el .example):
#         cp agente_ia/.env.example agente_ia/.env
#   2. Rellena tu API key de Gemini.
#   3. ¡NO subas el archivo .env a GitHub!
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_DB=banco_telemetria
PG_USER=openmetadata_reader
PG_PASS=om_reader_2026

# ─── URL de Loki para consulta de logs ─────────────────────
LOKI_URL=http://localhost:3100

# ─── Proveedor de IA ───────────────────────────────────────
# Opciones: 'openai' o 'gemini'
#AI_PROVIDER=openai

# Si usas OpenAI:
#OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#AI_MODEL=gpt-4o-mini

# Si usas Gemini (comenta las líneas de OpenAI y usa estas):
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy-XXXXXXXXXXXXXXXXXXXXXX
AI_MODEL=gemini-2.5-flash
